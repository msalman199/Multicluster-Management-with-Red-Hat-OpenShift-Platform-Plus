Subtask 3.3: Create Alert Rules for RHACM
Create RHACM-specific alert rules:
cat << 'EOF' > rhacm-alert-rules.yaml
apiVersion: monitoring.coreos.com/v1
kind: PrometheusRule
metadata:
  name: rhacm-alerts
  namespace: rhacm-observability
  labels:
    team: rhacm
spec:
  groups:
  - name: rhacm.cluster.rules
    rules:
    - alert: ManagedClusterDown
      expr: cluster_status == 0
      for: 5m
      labels:
        severity: critical
      annotations:
        summary: "Managed cluster {{ $labels.cluster }} is down"
        description: "Managed cluster {{ $labels.cluster }} has been down for more than 5 minutes."
    
    - alert: HighCPUUsage
      expr: avg by (cluster) (cpu_usage_percent) > 80
      for: 10m
      labels:
        severity: warning
      annotations:
        summary: "High CPU usage on cluster {{ $labels.cluster }}"
        description: "CPU usage on cluster {{ $labels.cluster }} is above 80% for more than 10 minutes."
    
    - alert: HighMemoryUsage
      expr: avg by (cluster) (memory_usage_percent) > 85
      for: 10m
      labels:
        severity: warning
      annotations:
        summary: "High memory usage on cluster {{ $labels.cluster }}"
        description: "Memory usage on cluster {{ $labels.cluster }} is above 85% for more than 10 minutes."
    
    - alert: ApplicationDeploymentFailed
      expr: application_status{status="failed"} == 1
      for: 2m
      labels:
        severity: critical
      annotations:
        summary: "Application deployment failed"
        description: "Application {{ $labels.application }} deployment failed on cluster {{ $labels.cluster }}."
    
    - alert: PolicyViolation
      expr: policy_violation_count > 0
      for: 1m
      labels:
        severity: warning
      annotations:
        summary: "Policy violation detected"
        description: "{{ $value }} policy violations detected on cluster {{ $labels.cluster }}."
EOF

# Apply alert rules
oc apply -f rhacm-alert-rules.yaml
Create cluster health monitoring rules:
cat << 'EOF' > cluster-health-rules.yaml
apiVersion: monitoring.coreos.com/v1
kind: PrometheusRule
metadata:
  name: cluster-health-alerts
  namespace: rhacm-observability
  labels:
    team: rhacm
spec:
  groups:
  - name: cluster.health.rules
    rules:
    - alert: ClusterNodeNotReady
      expr: cluster_node_status{status="NotReady"} == 1
      for: 5m
      labels:
        severity: critical
      annotations:
        summary: "Cluster node not ready"
        description: "Node {{ $labels.node }} in cluster {{ $labels.cluster }} is not ready for more than 5 minutes."
    
    - alert: PodCrashLooping
      expr: increase(pod_restart_count[1h]) > 5
      for: 5m
      labels:
        severity: warning
      annotations:
        summary: "Pod crash looping"
        description: "Pod {{ $labels.pod }} in namespace {{ $labels.namespace }} is crash looping."
    
    - alert: PersistentVolumeUsageHigh
      expr: pv_usage_percent > 90
      for: 5m
      labels:
        severity: critical
      annotations:
        summary: "Persistent volume usage high"
        description: "Persistent volume {{ $labels.pv }} usage is above 90%."
EOF

