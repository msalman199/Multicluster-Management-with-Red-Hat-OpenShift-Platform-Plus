Subtask 2.3: Implementing Security Policies Across Clusters
Step 12: Deploy Open Policy Agent (OPA) Gatekeeper
# Install Gatekeeper on all clusters
for cluster in dev-cluster staging-cluster prod-cluster; do
    echo "Installing Gatekeeper on $cluster"
    kubectl config use-context kind-$cluster
    
    # Install Gatekeeper
    kubectl apply -f https://raw.githubusercontent.com/open-policy-agent/gatekeeper/release-3.14/deploy/gatekeeper.yaml
    
    # Wait for Gatekeeper to be ready
    kubectl wait --for=condition=available --timeout=300s deployment/gatekeeper-controller-manager -n gatekeeper-system
done
Step 13: Create and Apply Security Policies
# Create a constraint template for required labels
cat << EOF > required-labels-template.yaml
apiVersion: templates.gatekeeper.sh/v1beta1
kind: ConstraintTemplate
metadata:
  name: k8srequiredlabels
spec:
  crd:
    spec:
      names:
        kind: K8sRequiredLabels
      validation:
        openAPIV3Schema:
          type: object
          properties:
            labels:
              type: array
              items:
                type: string
  targets:
    - target: admission.k8s.gatekeeper.sh
      rego: |
        package k8srequiredlabels
        
        violation[{"msg": msg}] {
          required := input.parameters.labels
          provided := input.review.object.metadata.labels
          missing := required[_]
          not provided[missing]
          msg := sprintf("Missing required label: %v", [missing])
        }
EOF

# Create constraint for environment labeling
cat << EOF > environment-labels-constraint.yaml
apiVersion: constraints.gatekeeper.sh/v1beta1
kind: K8sRequiredLabels
metadata:
  name: must-have-environment
spec:
  match:
    kinds:
      - apiGroups: ["apps"]
        kinds: ["Deployment"]
  parameters:
    labels: ["environment", "team"]
EOF

# Apply policies to all clusters
for cluster in dev-cluster staging-cluster prod-cluster; do
    echo "Applying security policies to $cluster"
    kubectl config use-context kind-$cluster
    kubectl apply -f required-labels-template.yaml
    kubectl apply -f environment-labels-constraint.yaml
done
