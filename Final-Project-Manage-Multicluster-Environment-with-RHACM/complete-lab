Subtask 4.2: Configure Custom Metrics and Alerts
Set up custom metrics collection and alerting rules.

Create custom metrics configuration:
# Create file: custom-metrics.yaml
cat << EOF > custom-metrics.yaml
apiVersion: observability.open-cluster-management.io/v1beta1
kind: ObservabilityAddon
metadata:
  name: observability-addon
  namespace: open-cluster-management-addon-observability
spec:
  enableMetrics: true
  interval: 30
  resources:
    limits:
      memory: 1000Mi
    requests:
      memory: 200Mi
EOF

# Apply custom metrics configuration
oc apply -f custom-metrics.yaml
Create alerting rules:
# Create file: alerting-rules.yaml
cat << EOF > alerting-rules.yaml
apiVersion: v1
kind: ConfigMap
metadata:
  name: custom-alerting-rules
  namespace: open-cluster-management-observability
data:
  custom_rules.yaml: |
    groups:
    - name: multicluster.rules
      rules:
      - alert: ClusterDown
        expr: up{job="cluster-version"} == 0
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: "Cluster {{ \$labels.cluster }} is down"
          description: "Cluster {{ \$labels.cluster }} has been down for more than 5 minutes."
      
      - alert: HighPodCPUUsage
        expr: (sum(rate(container_cpu_usage_seconds_total{container!="POD",container!=""}[5m])) by (cluster, namespace, pod) / sum(container_spec_cpu_quota{container!="POD",container!=""}/container_spec_cpu_period{container!="POD",container!=""}) by (cluster, namespace, pod)) > 0.8
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "High CPU usage detected"
          description: "Pod {{ \$labels.pod }} in namespace {{ \$labels.namespace }} on cluster {{ \$labels.cluster }} has high CPU usage."
EOF

# Apply alerting rules
oc apply -f alerting-rules.yaml
