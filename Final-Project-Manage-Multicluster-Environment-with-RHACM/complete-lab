Task 3: Implement Security Policies
Subtask 3.1: Create Network Security Policies
Implement network security policies to control traffic between applications and clusters.

Create network policy for application isolation:
# Create file: network-policy.yaml
cat << EOF > network-policy.yaml
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: demo-app-network-policy
  namespace: demo-app
spec:
  podSelector:
    matchLabels:
      app: demo-web-app
  policyTypes:
  - Ingress
  - Egress
  ingress:
  - from:
    - namespaceSelector:
        matchLabels:
          name: openshift-ingress
    ports:
    - protocol: TCP
      port: 80
  egress:
  - to: []
    ports:
    - protocol: TCP
      port: 53
    - protocol: UDP
      port: 53
  - to:
    - namespaceSelector: {}
    ports:
    - protocol: TCP
      port: 443
EOF

# Apply network policy
oc apply -f network-policy.yaml --context=cluster-east
oc apply -f network-policy.yaml --context=cluster-west
Create RHACM Policy for network security:
# Create file: rhacm-network-policy.yaml
cat << EOF > rhacm-network-policy.yaml
apiVersion: policy.open-cluster-management.io/v1
kind: Policy
metadata:
  name: network-security-policy
  namespace: multicluster-apps
spec:
  remediationAction: enforce
  disabled: false
  policy-templates:
  - objectDefinition:
      apiVersion: policy.open-cluster-management.io/v1
      kind: ConfigurationPolicy
      metadata:
        name: network-policy-config
      spec:
        remediationAction: enforce
        severity: high
        object-templates:
        - complianceType: musthave
          objectDefinition:
            apiVersion: networking.k8s.io/v1
            kind: NetworkPolicy
            metadata:
              name: default-deny-all
              namespace: demo-app
            spec:
              podSelector: {}
              policyTypes:
              - Ingress
              - Egress
---
apiVersion: policy.open-cluster-management.io/v1
kind: PlacementBinding
metadata:
  name: network-security-binding
  namespace: multicluster-apps
placementRef:
  name: demo-app-placement
  kind: PlacementRule
  apiGroup: apps.open-cluster-management.io
subjects:
- name: network-security-policy
  kind: Policy
  apiGroup: policy.open-cluster-management.io
EOF

# Apply RHACM network policy
oc apply -f rhacm-network-policy.yaml
Subtask 3.2: Implement Pod Security Standards
