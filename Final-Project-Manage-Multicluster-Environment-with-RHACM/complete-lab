Subtask 3.3: Configure RBAC Policies
Implement Role-Based Access Control policies across clusters.

Create RBAC policy for application management:
# Create file: rbac-policy.yaml
cat << EOF > rbac-policy.yaml
apiVersion: policy.open-cluster-management.io/v1
kind: Policy
metadata:
  name: rbac-policy
  namespace: multicluster-apps
spec:
  remediationAction: enforce
  disabled: false
  policy-templates:
  - objectDefinition:
      apiVersion: policy.open-cluster-management.io/v1
      kind: ConfigurationPolicy
      metadata:
        name: rbac-config
      spec:
        remediationAction: enforce
        severity: high
        object-templates:
        - complianceType: musthave
          objectDefinition:
            apiVersion: rbac.authorization.k8s.io/v1
            kind: Role
            metadata:
              name: demo-app-manager
              namespace: demo-app
            rules:
            - apiGroups: [""]
              resources: ["pods", "services"]
              verbs: ["get", "list", "watch"]
            - apiGroups: ["apps"]
              resources: ["deployments"]
              verbs: ["get", "list", "watch", "update", "patch"]
        - complianceType: musthave
          objectDefinition:
            apiVersion: rbac.authorization.k8s.io/v1
            kind: RoleBinding
            metadata:
              name: demo-app-manager-binding
              namespace: demo-app
            subjects:
            - kind: User
              name: demo-user
              apiGroup: rbac.authorization.k8s.io
            roleRef:
              kind: Role
              name: demo-app-manager
              apiGroup: rbac.authorization.k8s.io
EOF

# Apply RBAC policy
oc apply -f rbac-policy.yaml
Verify policy compliance:
# Check policy status
oc get policies -n multicluster-apps

# Check policy compliance details
oc describe policy network-security-policy -n multicluster-apps
oc describe policy pod-security-policy -n multicluster-apps
oc describe policy rbac-policy -n multicluster-apps
