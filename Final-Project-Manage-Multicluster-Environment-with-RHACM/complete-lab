cat << EOF > managed-cluster-west.yaml
apiVersion: cluster.open-cluster-management.io/v1
kind: ManagedCluster
metadata:
  name: cluster-west
  labels:
    environment: staging
    region: west
    vendor: OpenShift
spec:
  hubAcceptsClient: true
EOF

# Apply the managed cluster
oc apply -f managed-cluster-west.yaml
Verify cluster import status:
# Check managed clusters status
