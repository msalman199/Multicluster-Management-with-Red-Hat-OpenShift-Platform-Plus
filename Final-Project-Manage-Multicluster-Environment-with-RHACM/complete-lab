Task 2: Deploy Applications Across Clusters
Subtask 2.1: Create Application Namespace and Resources
Set up the foundation for multicluster application deployment.

Create application namespace:
# Create namespace on hub cluster
oc create namespace multicluster-apps

# Create namespace on managed clusters
oc create namespace demo-app --context=cluster-east
oc create namespace demo-app --context=cluster-west
Create placement rules:
# Create file: placement-rule.yaml
cat << EOF > placement-rule.yaml
apiVersion: apps.open-cluster-management.io/v1
kind: PlacementRule
metadata:
  name: demo-app-placement
  namespace: multicluster-apps
spec:
  clusterSelector:
    matchLabels:
      environment: production
  clusterReplicas: 1
EOF

# Apply placement rule
oc apply -f placement-rule.yaml
Verify placement:
# Check placement decisions
oc get placementrule demo-app-placement -n multicluster-apps -o yaml
Subtask 2.2: Deploy Sample Web Application
Deploy a sample web application across multiple clusters using RHACM.

Create application deployment:
# Create file: demo-app-deployment.yaml
cat << EOF > demo-app-deployment.yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: demo-web-app
  namespace: demo-app
  labels:
    app: demo-web-app
spec:
  replicas: 2
  selector:
    matchLabels:
      app: demo-web-app
  template:
    metadata:
      labels:
        app: demo-web-app
    spec:
      containers:
      - name: web-app
        image: nginx:1.21
        ports:
        - containerPort: 80
        resources:
          requests:
            memory: "64Mi"
            cpu: "50m"
          limits:
            memory: "128Mi"
            cpu: "100m"
---
apiVersion: v1
kind: Service
metadata:
  name: demo-web-app-service
  namespace: demo-app
spec:
  selector:
    app: demo-web-app
  ports:
  - port: 80
    targetPort: 80
  type: ClusterIP
EOF

# Apply deployment
oc apply -f demo-app-deployment.yaml
Create RHACM Application:
# Create file: rhacm-application.yaml
cat << EOF > rhacm-application.yaml
apiVersion: app.k8s.io/v1beta1
kind: Application
metadata:
  name: demo-multicluster-app
  namespace: multicluster-apps
spec:
  componentKinds:
  - group: apps.open-cluster-management.io
    kind: Subscription
  descriptor: {}
  selector:
    matchExpressions:
    - key: app
      operator: In
      values:
      - demo-multicluster-app
---
apiVersion: apps.open-cluster-management.io/v1
kind: Channel
metadata:
  name: demo-app-channel
  namespace: multicluster-apps
spec:
  type: Namespace
  pathname: multicluster-apps
---
apiVersion: apps.open-cluster-management.io/v1
kind: Subscription
metadata:
  name: demo-app-subscription
  namespace: multicluster-apps
  labels:
    app: demo-multicluster-app
spec:
  channel: multicluster-apps/demo-app-channel
  placement:
    placementRef:
      name: demo-app-placement
      kind: PlacementRule
EOF

# Apply RHACM application
oc apply -f rhacm-application.yaml
Verify application deployment:
# Check application status
oc get applications -n multicluster-apps

# Check subscription status
oc get subscriptions -n multicluster-apps

# Verify deployment on managed clusters
oc get deployments -n demo-app --context=cluster-east
oc get deployments -n demo-app --context=cluster-west
