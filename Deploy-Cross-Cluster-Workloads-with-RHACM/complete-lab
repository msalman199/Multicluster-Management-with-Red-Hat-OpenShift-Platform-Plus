Subtask 3.4: Monitor Application Health
Create Health Check Script
Create health-check.sh:

#!/bin/bash

echo "=== Cross-Cluster Application Health Check ==="

# Function to check cluster health
check_cluster_health() {
    local cluster=$1
    local namespace=$2
    
    echo "Checking $cluster cluster..."
    oc config use-context $cluster
    
    # Check deployment status
    local ready_replicas=$(oc get deployment sample-app -n $namespace -o jsonpath='{.status.readyReplicas}' 2>/dev/null || echo "0")
    local desired_replicas=$(oc get deployment sample-app -n $namespace -o jsonpath='{.spec.replicas}' 2>/dev/null || echo "0")
    
    echo "  Deployment: $ready_replicas/$desired_replicas replicas ready"
    
    # Check pod status
    local running_pods=$(oc get pods -n $namespace --field-selector=status.phase=Running --no-headers 2>/dev/null | wc -l)
    echo "  Running pods: $running_pods"
    
    # Check service endpoints
    local endpoints=$(oc get endpoints sample-app-service -n $namespace -o jsonpath='{.subsets[0].addresses}' 2>/dev/null | jq length 2>/dev/null || echo "0")
    echo "  Service endpoints: $endpoints"
    
    echo ""
}

# Check both clusters
check_cluster_health "cluster-east" "sample-app-east"
check_cluster_health "cluster-west" "sample-app-west"

echo "Health check completed."
Run Health Check
# Make script executable
chmod +x health-check.sh

# Run health check
./health-check.sh
Subtask 3.5: Implement Automated Validation
Create Validation Tests
Create validation-tests.yaml:

apiVersion: v1
kind: ConfigMap
metadata:
  name: validation-tests
  namespace: cross-cluster-apps
data:
  test-script.sh: |
    #!/bin/bash
    
    # Test 1: Verify deployment exists
    test_deployment_exists() {
        local cluster=$1
        local namespace=$2
        
        oc config use-context $cluster
        if oc get deployment sample-app -n $namespace >/dev/null 2>&1; then
            echo "✓ Deployment exists in $cluster"
            return 0
        else
            echo "✗ Deployment missing in $cluster"
            return 1
        fi
    }
    
    # Test 2: Verify correct environment variables
    test_environment_vars() {
        local cluster=$1
        local namespace=$2
        local expected_region=$3
        
        oc config use-context $cluster
        local actual_region=$(oc get deployment sample-app -n $namespace -o jsonpath='{.spec.template.spec.containers[0].env[?(@.name=="CLUSTER_REGION")].value}')
        
        if [ "$actual_region" = "$expected_region" ]; then
            echo "✓ Environment variables correct in $cluster"
            return 0
        else
            echo "✗ Environment variables incorrect in $cluster (expected: $expected_region, actual: $actual_region)"
            return 1
        fi
    }
    
    # Run tests
    echo "Running validation tests..."
    
    test_deployment_exists "cluster-east" "sample-app-east"
    test_deployment_exists "cluster-west" "sample-app-west"
    
    test_environment_vars "cluster-east" "sample-app-east" "east"
    test_environment_vars "cluster-west" "sample-app-west" "west"
    
    echo "Validation tests completed."
Apply and Execute Validation
# Apply validation ConfigMap
oc apply -f validation-tests.yaml

# Extract and run validation script
oc extract configmap/validation-tests --to=. -n cross-cluster-apps
chmod +x test-script.sh
./test-script.sh
Troubleshooting Common Issues
Issue 1: ApplicationSet Not Creating Applications
Symptoms: ApplicationSet exists but no applications are created

Solution:

# Check ApplicationSet status
oc describe applicationset cross-cluster-appset -n openshift-gitops

# Verify cluster labels match selectors
oc get managedclusters --show-labels

# Check ArgoCD controller logs
oc logs -n openshift-gitops -l app.kubernetes.io/name=argocd-applicationset-controller
Issue 2: Git Repository Access Issues
Symptoms: Applications show "ComparisonError" or "SyncError"

Solution:

# Verify repository credentials
oc get secret -n openshift-gitops | grep repo

# Test git repository access
git clone https://github.com/your-username/cross-cluster-app.git /tmp/test-repo
Issue 3: Placement Policy Not Working
Symptoms: Applications not deploying to expected clusters

Solution:

# Check placement decisions
oc get placementdecisions -n cross-cluster-apps

# Verify cluster labels
oc describe managedcluster cluster-east
oc describe managedcluster cluster-west

# Check placement status
oc describe placement geo-placement -n cross-cluster-apps
Advanced Configuration Options
Multi-Region Disaster Recovery Setup
For production environments, consider implementing disaster recovery:

apiVersion: cluster.open-cluster-management.io/v1beta1
kind: Placement
metadata:
  name: dr-placement
  namespace: cross-cluster-apps
spec:
  numberOfClusters: 2
  predicates:
    - requiredClusterSelector:
        labelSelector:
          matchExpressions:
            - key: disaster-recovery
              operator: In
              values: ["primary", "secondary"]
  prioritizerPolicy:
    mode: Exact
    configurations:
    - scoreCoordinate:
        builtIn: Steady
      weight: 1
Blue-Green Deployment Strategy
Implement blue-green deployments across clusters:

apiVersion: argoproj.io/v1alpha1
kind: Rollout
metadata:
  name: sample-app-rollout
spec:
  replicas: 5
  strategy:
    blueGreen:
      activeService: sample-app-active
      previewService: sample-app-preview
      autoPromotionEnabled: false
      scaleDownDelaySeconds: 30
  selector:
    matchLabels:
      app: sample-app
  template:
    metadata:
      labels:
        app: sample-app
    spec:
      containers:
      - name: sample-app
