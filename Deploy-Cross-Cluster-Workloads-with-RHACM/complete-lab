Subtask 2.4: Create RHACM Application
Create Application Definition
Create rhacm-application.yaml:

apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: cross-cluster-sample-app
  namespace: openshift-gitops
spec:
  project: default
  source:
    repoURL: https://github.com/your-username/cross-cluster-app.git
    targetRevision: main
    path: overlays/east
  destination:
    server: https://kubernetes.default.svc
    namespace: sample-app-east
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
    - CreateNamespace=true
---
apiVersion: app.k8s.io/v1beta1
kind: Application
metadata:
  name: cross-cluster-app
  namespace: cross-cluster-apps
spec:
  componentKinds:
  - group: argoproj.io
    kind: Application
  descriptor: {}
  selector:
    matchExpressions:
    - key: app
      operator: In
      values:
      - cross-cluster-sample-app
Create ApplicationSet for Multi-Cluster Deployment
Create applicationset.yaml:

apiVersion: argoproj.io/v1alpha1
kind: ApplicationSet
metadata:
  name: cross-cluster-appset
  namespace: openshift-gitops
spec:
  generators:
  - clusters:
      selector:
        matchLabels:
          environment: production
      values:
        overlay: east
        namespace: sample-app-east
  - clusters:
      selector:
        matchLabels:
          environment: staging
      values:
        overlay: west
        namespace: sample-app-west
  template:
    metadata:
      name: '{{name}}-sample-app'
    spec:
      project: default
      source:
        repoURL: https://github.com/your-username/cross-cluster-app.git
        targetRevision: main
        path: 'overlays/{{values.overlay}}'
      destination:
        server: '{{server}}'
        namespace: '{{values.namespace}}'
      syncPolicy:
        automated:
          prune: true
          selfHeal: true
        syncOptions:
        - CreateNamespace=true
Apply ApplicationSet
# Apply the ApplicationSet
oc apply -f applicationset.yaml

# Verify ApplicationSet creation
oc get applicationset -n openshift-gitops
