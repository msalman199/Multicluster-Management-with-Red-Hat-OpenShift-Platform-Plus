Task 2: Configure Security Policies and Runtime Protection
Subtask 2.1: Install Secured Cluster Services
Step 1: Generate cluster init bundle

# Create a script to generate init bundle via API
cat << 'EOF' > generate-init-bundle.sh
#!/bin/bash

# Get admin password
ADMIN_PASSWORD=$(oc get secret central-htpasswd -n stackrox -o jsonpath='{.data.password}' | base64 -d)
CENTRAL_ROUTE=$(oc get route central -n stackrox -o jsonpath='{.spec.host}')

# Generate init bundle
curl -k -X POST \
  -u admin:$ADMIN_PASSWORD \
  -H "Content-Type: application/json" \
  -d '{"name": "'"$CLUSTER_NAME"'"}' \
  https://$CENTRAL_ROUTE/v1/cluster-init/init-bundles \
  -o init-bundle-response.json

# Extract the bundle
cat init-bundle-response.json | jq -r '.kubectlBundle' | base64 -d > cluster-init-bundle.yaml

echo "Init bundle generated successfully"
EOF

chmod +x generate-init-bundle.sh
./generate-init-bundle.sh
Step 2: Apply the init bundle

# Apply the cluster init bundle
oc apply -f cluster-init-bundle.yaml -n stackrox

# Verify the secrets were created
oc get secrets -n stackrox | grep -E "(sensor|collector|admission-control)"
Step 3: Create SecuredCluster custom resource

# Create secured-cluster.yaml
cat << EOF > secured-cluster.yaml
apiVersion: platform.stackrox.io/v1alpha1
kind: SecuredCluster
metadata:
  name: stackrox-secured-cluster-services
  namespace: stackrox
spec:
  clusterName: $CLUSTER_NAME
  auditLogs:
    collection: Auto
  centralEndpoint: central.stackrox:443
  admissionControl:
    listenOnCreates: true
    listenOnEvents: true
    listenOnUpdates: true
    enforceOnCreates: true
    enforceOnUpdates: true
    scanInline: true
    disableBypass: false
    timeoutSeconds: 20
  perNode:
    collector:
      collection: EBPF
      imageFlavor: Regular
    taintToleration: TolerateTaints
  sensor:
    resources:
      requests:
        memory: "1Gi"
        cpu: "1000m"
      limits:
        memory: "4Gi"
        cpu: "2000m"
EOF
Step 4: Deploy SecuredCluster

# Apply the SecuredCluster configuration
oc apply -f secured-cluster.yaml

# Monitor deployment
oc get pods -n stackrox -w
Step 5: Verify all components are running

# Check all RHACS components
oc get pods -n stackrox

# Verify sensor is communicating with central
oc logs -n stackrox deployment/sensor | grep -i "connection\|connected"
Subtask 2.2: Configure Security Policies
Step 1: Create custom security policy for container images

# Create image-policy.yaml
cat << EOF > image-policy.yaml
apiVersion: v1
kind: ConfigMap
metadata:
  name: custom-image-policy
  namespace: stackrox
data:
  policy.json: |
    {
      "name": "Custom Image Security Policy",
      "description": "Enforce secure container images",
      "disabled": false,
      "categories": ["Security Best Practices"],
      "lifecycleStages": ["DEPLOY"],
      "eventSource": "NOT_APPLICABLE",
      "exclusions": [],
      "scope": [],
      "severity": "HIGH_SEVERITY",
      "policyVersion": "1.1",
      "policySections": [
        {
          "sectionName": "Image Registry",
          "policyGroups": [
            {
              "fieldName": "Image Registry",
              "booleanOperator": "OR",
              "negate": false,
              "values": [
                {
                  "value": "registry.redhat.io/.*"
                },
                {
                  "value": "quay.io/.*"
                }
              ]
            }
          ]
        }
      ],
      "mitreAttackVectors": [],
      "criteriaLocked": false,
      "mitreVectorsLocked": false,
      "isDefault": false
    }
EOF
Step 2: Create runtime security policy

# Create runtime-policy.yaml
cat << EOF > runtime-policy.yaml
apiVersion: v1
kind: ConfigMap
metadata:
  name: runtime-security-policy
  namespace: stackrox
data:
  policy.json: |
    {
      "name": "Runtime Process Monitoring",
      "description": "Monitor and alert on suspicious runtime processes",
      "disabled": false,
      "categories": ["Runtime"],
      "lifecycleStages": ["RUNTIME"],
      "eventSource": "DEPLOYMENT_EVENT",
      "exclusions": [],
      "scope": [],
      "severity": "MEDIUM_SEVERITY",
      "policyVersion": "1.1",
      "policySections": [
        {
          "sectionName": "Process Activity",
          "policyGroups": [
            {
              "fieldName": "Unexpected Process Executed",
              "booleanOperator": "OR",
              "negate": false,
              "values": [
                {
                  "value": "true"
                }
              ]
            }
          ]
        }
      ],
      "mitreAttackVectors": [
        {
          "tactic": "TA0002",
          "techniques": ["T1059"]
        }
      ],
      "criteriaLocked": false,
      "mitreVectorsLocked": false,
      "isDefault": false
    }
EOF
Step 3: Apply the security policies

# Apply the policy configurations
oc apply -f image-policy.yaml
oc apply -f runtime-policy.yaml

# Verify ConfigMaps were created
oc get configmaps -n stackrox | grep policy
Subtask 2.3: Configure Network Policies
Step 1: Create network segmentation policy

# Create network-policy.yaml
cat << EOF > network-policy.yaml
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: rhacs-network-policy
  namespace: stackrox
spec:
  podSelector: {}
  policyTypes:
  - Ingress
  - Egress
  ingress:
  - from:
    - namespaceSelector:
        matchLabels:
          name: stackrox
    - namespaceSelector:
        matchLabels:
          name: openshift-monitoring
  - from: []
    ports:
    - protocol: TCP
      port: 8443
    - protocol: TCP
      port: 9443
  egress:
  - to: []
    ports:
    - protocol: TCP
      port: 443
    - protocol: TCP
      port: 8443
    - protocol: UDP
      port: 53
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: default-deny-all
  namespace: default
spec:
  podSelector: {}
  policyTypes:
  - Ingress
  - Egress
EOF
Step 2: Apply network policies

# Apply network policies
oc apply -f network-policy.yaml

# Verify network policies
oc get networkpolicy -n stackrox
oc get networkpolicy -n default
