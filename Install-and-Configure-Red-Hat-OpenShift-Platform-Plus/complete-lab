Troubleshooting Common Issues
Issue 1: CRC fails to start
Solution:

# Clean up and restart CRC
crc stop
crc delete
crc cleanup
crc setup
crc start
Issue 2: Managed clusters not appearing as "Ready"
Solution:

# Check import status
oc get managedcluster -o yaml

# Verify klusterlet pods on managed clusters
kubectl config use-context kind-managed-cluster-1
kubectl get pods -n open-cluster-management-agent

# Restart klusterlet if needed
kubectl delete pods -n open-cluster-management-agent --all
Issue 3: Console not accessible
Solution:

# Check console route
oc get route -n open-cluster-management

# Verify console pods
oc get pods -n open-cluster-management | grep console

# Restart console pods if needed
oc delete pods -n open-cluster-management -l app=console
