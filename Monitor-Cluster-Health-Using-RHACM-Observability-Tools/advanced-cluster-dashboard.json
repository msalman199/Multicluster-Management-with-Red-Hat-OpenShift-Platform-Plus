{
  "dashboard": {
    "id": null,
    "title": "Advanced Cluster Monitoring",
    "tags": ["rhacm", "advanced"],
    "templating": {
      "list": [
        {
          "name": "cluster",
          "type": "query",
          "query": "label_values(up, cluster)",
          "refresh": 1,
          "includeAll": true,
          "multi": true
        }
      ]
    },
    "panels": [
      {
        "id": 1,
        "title": "Pod Status by Cluster",
        "type": "stat",
        "targets": [
          {
            "expr": "sum by (cluster, phase) (kube_pod_status_phase{cluster=~\"$cluster\"})",
            "legendFormat": "{{cluster}} - {{phase}}"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 24,
          "x": 0,
          "y": 0
        }
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    }
  }
}
