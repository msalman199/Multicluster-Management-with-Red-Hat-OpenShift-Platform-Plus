Task 3: Configure Custom Alerts and Test Them
Subtask 3.1: Create Custom Alert Rules
Create a PrometheusRule for cluster health alerts:
cat > cluster-health-alerts.yaml << 'EOF'
apiVersion: monitoring.coreos.com/v1
kind: PrometheusRule
metadata:
  name: cluster-health-alerts
  namespace: open-cluster-management-observability
  labels:
    prometheus: kube-prometheus
    role: alert-rules
spec:
  groups:
  - name: cluster.health
    rules:
    - alert: ClusterHighCPUUsage
      expr: 100 - (avg by (cluster) (irate(node_cpu_seconds_total{mode="idle"}[5m])) * 100) > 80
      for: 5m
      labels:
        severity: warning
        cluster: "{{ $labels.cluster }}"
      annotations:
        summary: "High CPU usage detected on cluster {{ $labels.cluster }}"
        description: "Cluster {{ $labels.cluster }} has CPU usage above 80% for more than 5 minutes."
    
    - alert: ClusterHighMemoryUsage
      expr: (1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100 > 85
      for: 5m
      labels:
        severity: warning
        cluster: "{{ $labels.cluster }}"
      annotations:
        summary: "High memory usage detected on cluster {{ $labels.cluster }}"
        description: "Cluster {{ $labels.cluster }} has memory usage above 85% for more than 5 minutes."
    
    - alert: ClusterNodeDown
      expr: up{job="node-exporter"} == 0
      for: 1m
      labels:
        severity: critical
        cluster: "{{ $labels.cluster }}"
      annotations:
        summary: "Node is down in cluster {{ $labels.cluster }}"
        description: "Node {{ $labels.instance }} in cluster {{ $labels.cluster }} has been down for more than 1 minute."
EOF
Apply the alert rules:
oc apply -f cluster-health-alerts.yaml
Verify the rules are loaded:
oc get prometheusrules -n open-cluster-management-observability
Subtask 3.2: Configure AlertManager
Create AlertManager configuration:
cat > alertmanager-config.yaml << 'EOF'
apiVersion: v1
kind: Secret
metadata:
  name: alertmanager-main
  namespace: open-cluster-management-observability
type: Opaque
stringData:
  alertmanager.yaml: |
    global:
      smtp_smarthost: 'localhost:587'
      smtp_from: 'alerts@company.com'
    
    route:
      group_by: ['alertname', 'cluster']
      group_wait: 10s
      group_interval: 10s
      repeat_interval: 1h
      receiver: 'web.hook'
      routes:
      - match:
          severity: critical
        receiver: 'critical-alerts'
      - match:
          severity: warning
        receiver: 'warning-alerts'
    
    receivers:
    - name: 'web.hook'
      webhook_configs:
      - url: 'http://localhost:5001/'
    
    - name: 'critical-alerts'
      webhook_configs:
      - url: 'http://localhost:5001/critical'
        send_resolved: true
    
    - name: 'warning-alerts'
      webhook_configs:
      - url: 'http://localhost:5001/warning'
        send_resolved: true
EOF
Apply the AlertManager configuration:
oc apply -f alertmanager-config.yaml
Restart AlertManager to pick up new configuration:
oc rollout restart statefulset/alertmanager-main -n open-cluster-management-observability
Subtask 3.3: Test Alert Configuration
Create a test workload to trigger alerts:
cat > cpu-stress-test.yaml << 'EOF'
apiVersion: apps/v1
kind: Deployment
metadata:
  name: cpu-stress-test
  namespace: default
spec:
  replicas: 2
  selector:
    matchLabels:
      app: cpu-stress
  template:
    metadata:
      labels:
        app: cpu-stress
    spec:
      containers:
      - name: cpu-stress
        image: progrium/stress
        args: ["--cpu", "2", "--timeout", "300s"]
        resources:
          requests:
            cpu: 100m
            memory: 128Mi
          limits:
            cpu: 500m
            memory: 256Mi
EOF
Deploy the stress test:
oc apply -f cpu-stress-test.yaml
Monitor the stress test deployment:
oc get pods -l app=cpu-stress -w
Check if alerts are firing:
# Wait a few minutes, then check AlertManager
ALERTMANAGER_URL=$(oc get route alertmanager-main -n open-cluster-management-observability -o jsonpath='{.spec.host}')
echo "AlertManager URL: https://$ALERTMANAGER_URL"

# Check active alerts via API
curl -s "https://$ALERTMANAGER_URL/api/v1/alerts" | jq '.data[] | select(.labels.alertname=="ClusterHighCPUUsage")'
Verify alert notifications:
# Check AlertManager logs for webhook calls
oc logs -n open-cluster-management-observability statefulset/alertmanager-main | grep -i webhook
Clean up the stress test:
oc delete deployment cpu-stress-test -n default
