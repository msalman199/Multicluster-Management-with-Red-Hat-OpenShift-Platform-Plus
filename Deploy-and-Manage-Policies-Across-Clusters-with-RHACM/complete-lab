Task 1: Define and Deploy Pod Security Policies
Subtask 1.1: Understanding RHACM Policy Framework
RHACM uses a policy-based governance model to manage compliance across clusters. Let's start by exploring the existing policy structure.

Step 1: Connect to your hub cluster and examine the policy namespace

# Switch to the hub cluster context
oc config use-context hub-cluster

# Check if RHACM policies namespace exists
oc get namespaces | grep policies

# If not present, create the policies namespace
oc create namespace policies
Step 2: Explore existing policy templates

# List any existing policies
oc get policies -A

# Check for policy templates
oc get configurationpolicy -A
Subtask 1.2: Create Pod Security Policy Template
Step 1: Create a comprehensive pod security policy definition

# Create a directory for policy files
mkdir -p ~/rhacm-policies
cd ~/rhacm-policies
Step 2: Create the pod security policy YAML file

cat > pod-security-policy.yaml << 'EOF'
apiVersion: policy.open-cluster-management.io/v1
kind: Policy
metadata:
  name: pod-security-policy
  namespace: policies
  annotations:
    policy.open-cluster-management.io/standards: NIST-CSF
    policy.open-cluster-management.io/categories: PR.AC Identity Management Authentication and Access Control
    policy.open-cluster-management.io/controls: PR.AC-4 Access Control
spec:
  remediationAction: enforce
  disabled: false
  policy-templates:
    - objectDefinition:
        apiVersion: policy.open-cluster-management.io/v1
        kind: ConfigurationPolicy
        metadata:
          name: pod-security-policy-config
        spec:
          remediationAction: enforce
          severity: high
          namespaceSelector:
            exclude:
              - kube-*
              - openshift-*
            include:
              - default
              - production
              - development
          object-templates:
            - complianceType: musthave
              objectDefinition:
                apiVersion: v1
                kind: SecurityContextConstraints
                metadata:
                  name: restricted-pod-security
                allowHostDirVolumePlugin: false
                allowHostIPC: false
                allowHostNetwork: false
                allowHostPID: false
                allowHostPorts: false
                allowPrivilegedContainer: false
                allowedCapabilities: null
                defaultAddCapabilities: null
                fsGroup:
                  type: MustRunAs
                  ranges:
                    - min: 1
                      max: 65535
                readOnlyRootFilesystem: false
                requiredDropCapabilities:
                  - KILL
                  - MKNOD
                  - SETUID
                  - SETGID
                runAsUser:
                  type: MustRunAsNonRoot
                seLinuxContext:
                  type: MustRunAs
                supplementalGroups:
                  type: MustRunAs
                  ranges:
                    - min: 1
                      max: 65535
                volumes:
                  - configMap
                  - downwardAPI
                  - emptyDir
                  - persistentVolumeClaim
                  - projected
                  - secret
---
apiVersion: policy.open-cluster-management.io/v1
kind: PlacementBinding
metadata:
  name: binding-pod-security-policy
  namespace: policies
placementRef:
  name: placement-pod-security-policy
  kind: PlacementRule
  apiGroup: apps.open-cluster-management.io
subjects:
  - name: pod-security-policy
    kind: Policy
    apiGroup: policy.open-cluster-management.io
---
apiVersion: apps.open-cluster-management.io/v1
kind: PlacementRule
metadata:
  name: placement-pod-security-policy
  namespace: policies
spec:
  clusterConditions:
    - status: "True"
      type: ManagedClusterConditionAvailable
  clusterSelector:
    matchExpressions:
      - key: environment
        operator: In
        values:
          - production
          - development
EOF
Step 3: Apply the pod security policy

# Apply the policy to the hub cluster
oc apply -f pod-security-policy.yaml

# Verify the policy was created
oc get policy pod-security-policy -n policies

# Check the placement binding
oc get placementbinding binding-pod-security-policy -n policies
Subtask 1.3: Create Network Security Policy
Step 1: Define a network policy for pod-to-pod communication

cat > network-security-policy.yaml << 'EOF'
apiVersion: policy.open-cluster-management.io/v1
kind: Policy
metadata:
  name: network-security-policy
  namespace: policies
  annotations:
    policy.open-cluster-management.io/standards: NIST-CSF
    policy.open-cluster-management.io/categories: PR.AC Identity Management Authentication and Access Control
    policy.open-cluster-management.io/controls: PR.AC-3 Access Control
spec:
  remediationAction: enforce
  disabled: false
  policy-templates:
    - objectDefinition:
        apiVersion: policy.open-cluster-management.io/v1
        kind: ConfigurationPolicy
        metadata:
          name: network-policy-config
        spec:
          remediationAction: enforce
          severity: medium
          namespaceSelector:
            include:
              - production
              - development
          object-templates:
            - complianceType: musthave
              objectDefinition:
                apiVersion: networking.k8s.io/v1
                kind: NetworkPolicy
                metadata:
                  name: deny-all-ingress
                  namespace: production
                spec:
                  podSelector: {}
                  policyTypes:
                    - Ingress
            - complianceType: musthave
              objectDefinition:
                apiVersion: networking.k8s.io/v1
                kind: NetworkPolicy
                metadata:
                  name: allow-same-namespace
                  namespace: production
                spec:
                  podSelector: {}
                  policyTypes:
                    - Ingress
                  ingress:
                    - from:
                        - namespaceSelector:
                            matchLabels:
                              name: production
