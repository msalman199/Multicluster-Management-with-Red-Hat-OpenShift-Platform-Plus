EOF

oc apply -f image-policy-config.yaml
Subtask 2.2: Create Application Image Management Policies
Define image source policies:
cat << 'EOF' > image-source-policy.yaml
apiVersion: policy.open-cluster-management.io/v1
kind: Policy
metadata:
  name: image-source-control-policy
  namespace: rhacm-image-management
spec:
  remediationAction: enforce
  disabled: false
  policy-templates:
    - objectDefinition:
        apiVersion: policy.open-cluster-management.io/v1
        kind: ConfigurationPolicy
        metadata:
          name: allowed-registries-policy
        spec:
          remediationAction: enforce
          severity: high
          namespaceSelector:
            exclude:
              - kube-*
              - openshift-*
            include:
              - default
              - quay-integration
          object-templates:
            - complianceType: musthave
              objectDefinition:
                apiVersion: config.openshift.io/v1
                kind: Image
                metadata:
                  name: cluster
                spec:
                  allowedRegistriesForImport:
                    - domainName: quay-registry.apps.cluster.local
                      insecure: false
                    - domainName: registry.redhat.io
                      insecure: false
                    - domainName: quay.io
                      insecure: false
                  registrySources:
                    allowedRegistries:
                      - quay-registry.apps.cluster.local
                      - registry.redhat.io
                      - quay.io
                      - registry.access.redhat.com
EOF

oc apply -f image-source-policy.yaml
Create image scanning policy:
cat << 'EOF' > image-scanning-policy.yaml
apiVersion: policy.open-cluster-management.io/v1
kind: Policy
metadata:
  name: image-scanning-policy
  namespace: rhacm-image-management
spec:
  remediationAction: inform
  disabled: false
  policy-templates:
    - objectDefinition:
        apiVersion: policy.open-cluster-management.io/v1
        kind: ConfigurationPolicy
        metadata:
          name: image-vulnerability-policy
        spec:
          remediationAction: inform
          severity: medium
          namespaceSelector:
            include:
              - default
              - quay-integration
          object-templates:
            - complianceType: musthave
              objectDefinition:
                apiVersion: v1
                kind: ConfigMap
                metadata:
                  name: image-scanning-config
                  namespace: '{{ fromClusterClaim "name" }}'
                data:
                  scanning-enabled: "true"
                  max-severity: "medium"
                  scan-on-push: "true"
EOF

oc apply -f image-scanning-policy.yaml
Subtask 2.3: Deploy Sample Application with Quay Integration
Create sample application using Quay images:
cat << 'EOF' > sample-app-deployment.yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: quay-sample-app
  namespace: quay-integration
  labels:
    app: quay-sample-app
spec:
  replicas: 2
  selector:
    matchLabels:
      app: quay-sample-app
  template:
    metadata:
      labels:
        app: quay-sample-app
    spec:
      imagePullSecrets:
        - name: quay-registry-secret
      containers:
        - name: sample-app
          image: quay-registry.apps.cluster.local/admin/sample-nginx:latest
          ports:
            - containerPort: 8080
          resources:
            requests:
              memory: "64Mi"
              cpu: "50m"
            limits:
              memory: "128Mi"
              cpu: "100m"
---
apiVersion: v1
kind: Service
metadata:
  name: quay-sample-app-service
  namespace: quay-integration
spec:
  selector:
    app: quay-sample-app
  ports:
    - protocol: TCP
      port: 80
      targetPort: 8080
  type: ClusterIP
EOF

oc apply -f sample-app-deployment.yaml
Verify application deployment:
# Check deployment status
oc get deployments -n quay-integration

# Check pod status
oc get pods -n quay-integration

# Check service creation
oc get services -n quay-integration
Task 3: Ensure Image Source Control and Access Across Clusters
Subtask 3.1: Configure Multi-Cluster Image Policies
Create placement rule for multi-cluster deployment:
cat << 'EOF' > multi-cluster-placement.yaml
apiVersion: apps.open-cluster-management.io/v1
kind: PlacementRule
metadata:
  name: quay-policy-placement
  namespace: rhacm-image-management
spec:
  clusterConditions:
    - status: "True"
      type: ManagedClusterConditionAvailable
  clusterSelector:
    matchExpressions:
      - key: environment
        operator: In
        values:
          - dev
          - staging
          - production
---
apiVersion: policy.open-cluster-management.io/v1
kind: PlacementBinding
metadata:
  name: quay-policy-binding
  namespace: rhacm-image-management
placementRef:
  name: quay-policy-placement
  kind: PlacementRule
  apiGroup: apps.open-cluster-management.io
subjects:
  - name: quay-image-policy
    kind: Policy
    apiGroup: policy.open-cluster-management.io
  - name: image-source-control-policy
    kind: Policy
    apiGroup: policy.open-cluster-management.io
  - name: image-scanning-policy
    kind: Policy
    apiGroup: policy.open-cluster-management.io
EOF

oc apply -f multi-cluster-placement.yaml
Subtask 3.2: Implement Image Access Control
Create role-based access control for Quay:
cat << 'EOF' > quay-rbac-config.yaml
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: quay-image-manager
rules:
  - apiGroups: [""]
    resources: ["secrets"]
    verbs: ["get", "list", "create", "update", "patch"]
  - apiGroups: ["apps"]
    resources: ["deployments", "replicasets"]
    verbs: ["get", "list", "watch", "create", "update", "patch"]
  - apiGroups: ["config.openshift.io"]
    resources: ["images"]
    verbs: ["get", "list", "watch", "update", "patch"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: quay-image-manager-binding
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: quay-image-manager
subjects:
  - kind: ServiceAccount
    name: quay-service-account
    namespace: quay-integration
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: quay-service-account
  namespace: quay-integration
EOF

oc apply -f quay-rbac-config.yaml
Create image pull policy enforcement:
cat << 'EOF' > image-pull-policy.yaml
apiVersion: policy.open-cluster-management.io/v1
kind: Policy
metadata:
  name: image-pull-policy-enforcement
  namespace: rhacm-image-management
spec:
  remediationAction: enforce
  disabled: false
  policy-templates:
    - objectDefinition:
        apiVersion: policy.open-cluster-management.io/v1
        kind: ConfigurationPolicy
        metadata:
          name: enforce-image-pull-policy
        spec:
          remediationAction: enforce
          severity: high
          namespaceSelector:
            exclude:
              - kube-*
              - openshift-*
          object-templates:
            - complianceType: musthave
              objectDefinition:
                apiVersion: v1
                kind: LimitRange
                metadata:
                  name: image-pull-policy-limits
                  namespace: '{{ fromClusterClaim "name" }}'
                spec:
                  limits:
                    - default:
                        imagePullPolicy: Always
                      defaultRequest:
                        imagePullPolicy: Always
                      type: Container
EOF

oc apply -f image-pull-policy.yaml
Subtask 3.3: Monitor and Validate Image Compliance
Create monitoring dashboard configuration:
cat << 'EOF' > image-monitoring-config.yaml
apiVersion: v1
kind: ConfigMap
metadata:
  name: quay-monitoring-config
  namespace: rhacm-image-management
data:
  monitoring.yaml: |
    monitoring:
      enabled: true
      metrics:
        - image_pull_count
        - image_scan_results
        - policy_violations
        - registry_availability
      alerts:
        - name: unauthorized_image_pull
          condition: image_source != "quay-registry.apps.cluster.local"
          severity: high
        - name: vulnerability_detected
          condition: scan_result.severity >= "medium"
          severity: medium
        - name: registry_unavailable
          condition: registry_health != "healthy"
          severity: critical
EOF

oc apply -f image-monitoring-config.yaml
