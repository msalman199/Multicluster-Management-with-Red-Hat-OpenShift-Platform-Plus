Subtask 1.2: Create a Security Policy for Pod Security Standards
Create a namespace for policies
# Create policy namespace
oc create namespace policy-management

# Verify namespace creation
oc get namespace policy-management
Create a Pod Security Policy
Create a file named pod-security-policy.yaml:

apiVersion: policy.open-cluster-management.io/v1
kind: Policy
metadata:
  name: pod-security-policy
  namespace: policy-management
  annotations:
    policy.open-cluster-management.io/standards: NIST-CSF
    policy.open-cluster-management.io/categories: PR.AC Access Control
    policy.open-cluster-management.io/controls: PR.AC-4
spec:
  remediationAction: enforce
  disabled: false
  policy-templates:
    - objectDefinition:
        apiVersion: policy.open-cluster-management.io/v1
        kind: ConfigurationPolicy
        metadata:
          name: pod-security-policy-config
        spec:
          remediationAction: enforce
          severity: high
          namespaceSelector:
            exclude:
              - kube-*
              - open-cluster-management*
            include:
              - default
              - production
              - development
          object-templates:
            - complianceType: musthave
              objectDefinition:
                apiVersion: v1
                kind: Namespace
                metadata:
                  name: production
                  labels:
                    pod-security.kubernetes.io/enforce: restricted
                    pod-security.kubernetes.io/audit: restricted
                    pod-security.kubernetes.io/warn: restricted
            - complianceType: musthave
              objectDefinition:
                apiVersion: v1
                kind: Namespace
                metadata:
                  name: development
                  labels:
                    pod-security.kubernetes.io/enforce: baseline
                    pod-security.kubernetes.io/audit: baseline
                    pod-security.kubernetes.io/warn: baseline
Apply the Pod Security Policy
# Apply the policy
oc apply -f pod-security-policy.yaml

# Verify policy creation
oc get policy -n policy-management
oc describe policy pod-security-policy -n policy-management
Subtask 1.3: Create a Network Policy
Create a Network Security Policy
Create a file named network-policy.yaml:

apiVersion: policy.open-cluster-management.io/v1
kind: Policy
metadata:
  name: network-security-policy
  namespace: policy-management
  annotations:
    policy.open-cluster-management.io/standards: NIST-CSF
    policy.open-cluster-management.io/categories: PR.AC Access Control
    policy.open-cluster-management.io/controls: PR.AC-3
spec:
  remediationAction: enforce
  disabled: false
  policy-templates:
    - objectDefinition:
        apiVersion: policy.open-cluster-management.io/v1
        kind: ConfigurationPolicy
        metadata:
          name: network-policy-config
        spec:
          remediationAction: enforce
          severity: medium
          namespaceSelector:
            include:
              - production
              - development
          object-templates:
            - complianceType: musthave
              objectDefinition:
                apiVersion: networking.k8s.io/v1
                kind: NetworkPolicy
                metadata:
                  name: deny-all-ingress
                  namespace: production
                spec:
                  podSelector: {}
                  policyTypes:
                    - Ingress
            - complianceType: musthave
              objectDefinition:
                apiVersion: networking.k8s.io/v1
                kind: NetworkPolicy
                metadata:
                  name: allow-same-namespace
                  namespace: production
                spec:
                  podSelector: {}
                  policyTypes:
                    - Ingress
                  ingress:
                    - from:
                        - namespaceSelector:
                            matchLabels:
                              name: production
Apply the Network Policy
# Apply the network policy
oc apply -f network-policy.yaml

# Verify policy creation
oc get policy network-security-policy -n policy-management -o yaml
Subtask 1.4: Create a Resource Management Policy
Create a Resource Quota Policy
Create a file named resource-quota-policy.yaml:

apiVersion: policy.open-cluster-management.io/v1
kind: Policy
metadata:
  name: resource-quota-policy
  namespace: policy-management
  annotations:
    policy.open-cluster-management.io/standards: NIST-CSF
    policy.open-cluster-management.io/categories: PR.DS Data Security
    policy.open-cluster-management.io/controls: PR.DS-4
spec:
  remediationAction: enforce
  disabled: false
  policy-templates:
    - objectDefinition:
        apiVersion: policy.open-cluster-management.io/v1
        kind: ConfigurationPolicy
        metadata:
          name: resource-quota-config
        spec:
          remediationAction: enforce
          severity: low
          namespaceSelector:
            include:
              - production
              - development
          object-templates:
            - complianceType: musthave
              objectDefinition:
                apiVersion: v1
                kind: ResourceQuota
                metadata:
                  name: compute-quota
                  namespace: production
                spec:
                  hard:
                    requests.cpu: "4"
                    requests.memory: 8Gi
                    limits.cpu: "8"
                    limits.memory: 16Gi
                    persistentvolumeclaims: "10"
                    pods: "20"
            - complianceType: musthave
              objectDefinition:
                apiVersion: v1
                kind: ResourceQuota
                metadata:
                  name: compute-quota
                  namespace: development
                spec:
                  hard:
                    requests.cpu: "2"
                    requests.memory: 4Gi
                    limits.cpu: "4"
                    limits.memory: 8Gi
                    persistentvolumeclaims: "5"
                    pods: "10"
Apply the Resource Quota Policy
