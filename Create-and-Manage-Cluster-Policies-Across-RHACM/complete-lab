Subtask 3.4: Monitor Policy Violations and Compliance
Create Policy Violation Monitoring Script
cat > check-violations.sh << 'EOF'
#!/bin/bash

echo "=== Policy Violation Report ==="
echo

# Switch back to hub cluster
oc config use-context hub-cluster

# Check for policy violations
for policy in $(oc get policies -n policy-management -o name); do
    policy_name=$(basename $policy)
    echo "Checking policy: $policy_name"
    
    # Get violation details
    violations=$(oc get $policy -n policy-management -o jsonpath='{.status.status[?(@.compliant=="NonCompliant")]}')
    
    if [ ! -z "$violations" ]; then
        echo "  VIOLATIONS FOUND:"
        oc get $policy -n policy-management -o jsonpath='{range .status.status[?(@.compliant=="NonCompliant")]}    Cluster: {.clustername} - {.compliant}{"\n"}{end}'
    else
        echo "  No violations found"
    fi
    echo
done

# Check overall compliance summary
echo "=== Compliance Summary ==="
oc get policies -n policy-management -o custom-columns="NAME:.metadata.name,COMPLIANT:.status.compliant"
EOF

chmod +x check-violations.sh
./check-violations.sh
Generate Compliance Report
cat > compliance-report.sh << 'EOF'
#!/bin/bash

echo "=== RHACM Policy Compliance Report ==="
echo "Generated on: $(date)"
echo

# Get cluster information
echo "Managed Clusters:"
oc get managedclusters -o custom-columns="NAME:.metadata.name,STATUS:.status.conditions[?(@.type=='ManagedClusterConditionAvailable')].status,VERSION:.status.version.kubernetes"
echo

# Policy compliance overview
echo "Policy Compliance Overview:"
echo "=========================="

total_policies=$(oc get policies -n policy-management --no-headers | wc -l)
compliant_policies=$(oc get policies -n policy-management -o jsonpath='{.items[?(@.status.compliant=="Compliant")].metadata.name}' | wc -w)
non_compliant_policies=$(oc get policies -n policy-management -o jsonpath='{.items[?(@.status.compliant=="NonCompliant")].metadata.name}' | wc -w)

echo "Total Policies: $total_policies"
echo "Compliant Policies: $compliant_policies"
echo "Non-Compliant Policies: $non_compliant_policies"
echo

# Detailed policy status
echo "Detailed Policy Status:"
echo "======================"
oc get policies -n policy-management -o custom-columns="POLICY:.metadata.name,REMEDIATION:.spec.remediationAction,COMPLIANT:.status.compliant,CLUSTERS:.status.placement[*].placementRule"
echo

# Policy set status
echo "Policy Set Status:"
echo "=================="
oc get policysets -n policy-management -o custom-columns="NAME:.metadata.name,POLICIES:.spec.policies[*]"
EOF

chmod +x compliance-report.sh
./compliance-report.sh
Troubleshooting Common Issues
Issue 1: Policy Not Distributing to Managed Clusters
Symptoms: Policies remain in pending state or don't appear on managed clusters

Solution:

# Check placement rule status
oc get placementrules -n policy-management -o yaml

# Verify cluster labels match placement rule selectors
oc get managedclusters --show-labels

# Check placement binding configuration
oc describe placementbinding security-placement-binding -n policy-management

# Verify managed cluster agent status
oc get managedclusters -o custom-columns="NAME:.metadata.name,AVAILABLE:.status.conditions[?(@.type=='ManagedClusterConditionAvailable')].status"
Issue 2: Policy Enforcement Not Working
Symptoms: Resources are created despite policy restrictions

Solution:

# Check policy remediation action
oc get policy pod-security-policy -n policy-management -o jsonpath='{.spec.remediationAction}'

# Verify policy template configuration
oc get policy pod-security-policy -n policy-management -o yaml | grep -A 10 object-templates

# Check for admission controller issues on managed clusters
oc get events --all-namespaces | grep -i "admission\|webhook"
Issue 3: Resource Quota Not Applied
Symptoms: Resource quotas don't appear in target namespaces

Solution:

# Check if namespaces exist
oc get namespaces production development

# Verify namespace selector in policy
oc get policy resource-quota-policy -n policy-management -o jsonpath='{.spec.policy-templates[0].objectDefinition.spec.namespaceSelector}'

# Check policy compliance details
oc describe policy resource-quota-policy -n policy-management
